# Webflow Site API token with cms:read scope. Set this in Webflow Cloud's
# environment variables (via the Webflow CLI) — never commit a real value here.
WEBFLOW_API_TOKEN=

# Defaults already point at the real collections created for this project;
# override only if you recreate them.
WEBFLOW_PAGE_SECTIONS_COLLECTION_ID=6ab126f77424deb85b1615a1
WEBFLOW_SKATEBOARDS_COLLECTION_ID=6ab1153ec9b7b1d2579bb333
WEBFLOW_SKATERS_COLLECTION_ID=6ab1153fc61cb35b552ac7d8
